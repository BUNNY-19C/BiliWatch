<Window x:Class="BiliWatch.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="扫码登录 B 站" Width="420" Height="535" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="连接你的 B 站账号" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Grid.Row="1" Text="打开哔哩哔哩 App，扫一扫并确认登录" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,12"/>
    <Border Grid.Row="2" Background="White" CornerRadius="12" Width="256" Height="256" HorizontalAlignment="Center" VerticalAlignment="Center"><Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="B 站登录二维码"/></Border>
    <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="正在获取二维码…" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,16"/>
    <StackPanel Grid.Row="4"><Button x:Name="RefreshButton" Content="刷新二维码" Click="Refresh_Click" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="登录状态仅在本机加密保存" Style="{StaticResource Caption}" TextAlignment="Center"/></StackPanel>
  </Grid>
</Window>
