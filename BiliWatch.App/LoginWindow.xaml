<Window x:Class="BiliWatch.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="扫码登录 B 站" Width="440" Height="580" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F6FA">
  <Grid Margin="32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="连接你的 B 站账号" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Grid.Row="1" Text="打开哔哩哔哩 App，扫一扫并确认登录" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,18"/>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Width="276" Height="276" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid><TextBlock Text="二维码显示在这里" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="QrImage" Width="248" Height="248" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="B 站登录二维码"/></Grid>
    </Border>
    <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="正在获取二维码…" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,18,0,18"/>
    <StackPanel Grid.Row="4"><Button x:Name="RefreshButton" Content="刷新二维码" Click="Refresh_Click" Style="{StaticResource Primary}" HorizontalAlignment="Center" MinWidth="164" Margin="0,0,0,16"/><TextBlock Text="无需复制 Cookie · 登录状态仅在本机加密保存" Style="{StaticResource Caption}" TextAlignment="Center"/></StackPanel>
  </Grid>
</Window>
