<Window x:Class="BiliWatch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BiliWatch · 直播观看时长" Width="1360" Height="920" MinWidth="1080" MinHeight="760" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" Background="{StaticResource Blue}" CornerRadius="9" Margin="0,0,12,0">
            <Viewbox Margin="9"><Canvas Width="20" Height="20"><Path Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,14 L 3,8 M 10,17 L 10,3 M 17,14 L 17,6"/></Canvas></Viewbox>
          </Border>
          <TextBlock Text="BiliWatch" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="18,0"/>
          <TextBlock Text="直播观看记录" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="{Binding AccountText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding LoginText}" Style="{StaticResource Caption}" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel>
          <Button Content="扫码登录" Command="{Binding LoginCommand}"/><Button Content="退出" Style="{StaticResource Quiet}" Command="{Binding LogoutCommand}" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="28,22,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="24,18" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="本次成功查询合计" Foreground="{StaticResource Muted}"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,3"><TextBlock Text="{Binding Hours}" FontFamily="Segoe UI" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/><TextBlock Text="小时" Margin="10,0,0,8" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}"/></StackPanel>
            <TextBlock Text="{Binding ExactDuration}" Style="{StaticResource Caption}"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource Line}" Margin="0,4"/>
          <StackPanel Grid.Column="2" Margin="28,4,0,0"><TextBlock Text="查询成功" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding SuccessCount}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="计入本轮合计" Style="{StaticResource Caption}"/></StackPanel>
          <StackPanel Grid.Column="3" Margin="24,4,0,0"><TextBlock Text="查询失败" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding FailedCount}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6" Foreground="#AC4F20"/><TextBlock Text="支持单独重试" Style="{StaticResource Caption}"/></StackPanel>
          <StackPanel Grid.Column="4" Margin="24,4,0,0"><TextBlock Text="等待查询" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding PendingCount}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="含正在查询的主播" Style="{StaticResource Caption}"/></StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="0,0,0,16">
        <TextBlock Text="仅覆盖已发现主播，统计起点以 B 站接口为准。旧结果保留在明细中，不计入新一轮合计。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <WrapPanel><Button Content="开始查询" Style="{StaticResource Primary}" Command="{Binding StartCommand}" Padding="22,9"/><Button Content="取消" Command="{Binding CancelCommand}"/><Button Content="继续待查询项" Command="{Binding ResumeCommand}"/><Button Content="重试失败项" Command="{Binding RetryCommand}"/></WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="188" Tag="主播 UID，多个用逗号分隔" Text="{Binding ManualUid, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" ToolTip="主播个人空间的数字 UID，不是直播间号" AutomationProperties.Name="补充主播 UID" Margin="12,0,8,0"/><Button Content="补充 UID" Command="{Binding AddCommand}" Margin="0"/></StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" ToolTip="{Binding State}"><TextBlock Text="{Binding Source}" FontSize="12"/><TextBlock Text="{Binding Count, StringFormat='  {0} 位 · '}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding State}" FontSize="12" Foreground="{StaticResource Muted}" MaxWidth="130" TextTrimming="CharacterEllipsis"/></StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="自动发现：直播历史 / 粉丝勋章 / 全部关注"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Sources.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Caption}"/>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="主播明细" Style="{StaticResource SectionTitle}"/><TextBlock Text="点击表头排序 · 悬停查看详情" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
              <TextBox Grid.Column="1" Tag="搜索主播名称或 UID" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索主播名称或 UID" VerticalAlignment="Center"/>
            </Grid>
            <DataGrid Grid.Row="1" Margin="0,0,0,8" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F5" BorderThickness="0" Background="White" RowBackground="White" RowHeight="58" ColumnHeaderHeight="38" EnableRowVirtualization="True" SelectionMode="Single" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto">
              <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F9FC"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,1,0,1"/></Style>
                <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="14,6"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers></Style>
                <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding DetailText}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F8FD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EBF1FE"/></Trigger></Style.Triggers></Style>
                <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="主播 / UID" Width="*" MinWidth="150" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Name}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Uid}" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="累计观看时长" Binding="{Binding DurationText}" SortMemberPath="LastSeconds" Width="184" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="状态" SortMemberPath="State" Width="102"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Border Padding="8,4" CornerRadius="4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0F3F7"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Success"><Setter Property="Background" Value="#EAF5F0"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Background" Value="#FFF0E8"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Background" Value="#EBF1FE"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding StatusText}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#556176"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Success"><Setter Property="Foreground" Value="#247153"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="#A34D22"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Foreground" Value="#245CE0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                  </Border>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="发现来源" Width="145" SortMemberPath="SourceText"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" ToolTip="{Binding SourceText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" SortMemberPath="UpdatedAt" Width="140" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="从第一条观看记录开始" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="扫码登录后点击“开始查询”，自动发现你关注和看过的主播。" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="350" Margin="0,12,0,0"/></StackPanel>
            <TextBlock Grid.Row="1" Text="没有匹配的主播，请换个名称或 UID。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NoSearchResults}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="观看时长排行" Style="{StaticResource SectionTitle}"/><TextBlock Text="TOP 10" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Blue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <TextBlock Grid.Row="1" Text="本轮成功结果 · 单位：小时" Style="{StaticResource Caption}" Margin="0,6,0,18"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Ranking}"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,0,6,18" ToolTip="{Binding Duration}"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Rank, StringFormat='{}{0:00}'}" FontFamily="Segoe UI" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                  <StackPanel Grid.Column="1"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Hours}" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"/></Grid><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Style="{StaticResource ThinProgress}" AutomationProperties.Name="相对观看时长"/></StackPanel>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="每一份陪伴，都有记录。&#10;查询后查看观看最多的主播。" TextAlignment="Center" Foreground="{StaticResource Muted}" LineHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasRanking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Style="{StaticResource ThinProgress}" Height="3"/><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="28,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </Border>
  </Grid>
</Window>
